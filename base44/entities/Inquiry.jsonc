{
  "name": "Inquiry",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female"
      ],
      "description": "Gender"
    },
    "coverage_type": {
      "type": "string",
      "enum": [
        "Life Insurance",
        "Property & Casualty",
        "Financial Planning",
        "Not Sure / Tell Me More"
      ],
      "description": "Type of coverage interested in"
    },
    "has_existing_coverage": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Not Sure"
      ],
      "description": "Whether they currently have life insurance"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email",
    "phone",
    "date_of_birth",
    "gender",
    "coverage_type",
    "has_existing_coverage"
  ]
}